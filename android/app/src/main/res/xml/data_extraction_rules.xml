<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks stay on the phone. Use Settings > Export to keep a copy. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
